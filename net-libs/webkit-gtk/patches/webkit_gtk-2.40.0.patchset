 template<>
 std::optional<OptionsStorage::Size> parse(const char* string)
 {
@@ -101,7 +101,7 @@ std::optional<OptionsStorage::Size> parse(const char* string)
         return value;
     return std::nullopt;
 }
-#endif // CPU(ADDRESS64) || OS(DARWIN)
