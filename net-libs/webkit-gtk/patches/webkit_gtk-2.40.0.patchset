diff --git a/Source/WTF/wtf/PlatformRegisters.h b/Source/WTF/wtf/PlatformRegisters.h
index b981c13e..76cfd550 100644
--- a/Source/WTF/wtf/PlatformRegisters.h
+++ b/Source/WTF/wtf/PlatformRegisters.h
@@ -34,6 +34,8 @@
 #include <signal.h>
 #elif OS(WINDOWS)
